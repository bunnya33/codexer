REMOTE_DOMAIN=codex-remote.example.com
# Use random base64url values (letters, digits, underscore and hyphen).
# A base64url PostgreSQL password also needs no URL escaping in DATABASE_URL.
POSTGRES_PASSWORD=replace-with-random-base64url-value
RELAY_ADMIN_USERNAME=admin
RELAY_ADMIN_PASSWORD=replace-with-a-strong-password
