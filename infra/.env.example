REMOTE_DOMAIN=codex-remote.example.com
# 默认使用 SQLite；外部 PostgreSQL 可设置 DATABASE_URL。
# DATABASE_URL=postgresql://user:password@host:5432/database
RELAY_ADMIN_USERNAME=admin
RELAY_ADMIN_PASSWORD=replace-with-a-strong-password
# 微信 ClawBot 默认启用；加密密钥默认自动生成并保存在 relay-data 卷。
RELAY_WEIXIN_ENABLED=true
# 外部管理密钥时填写 64 位随机十六进制字符串。必须与数据库一起备份。
# RELAY_WEIXIN_KEY=
