{
  "name": "codex-remote",
  "version": "0.2.9",
  "private": true,
  "type": "module",
  "workspaces": [
    "apps/mobile",
    "apps/admin",
    "apps/desktop",
    "apps/control-desktop"
  ],
  "engines": {
    "node": ">=22.13"
  },
  "scripts": {
    "inspect:bundle": "node scripts/query-desktop-bundle.mjs",
    "probe:desktop": "node scripts/probe-desktop-ipc.mjs",
    "build": "npm run build:server",
    "build:server": "node scripts/clean-build.mjs && tsc -p tsconfig.server.json && npm run build:web && npm run build:admin",
    "build:web": "npm run check:preview-runtime && npm run export:web --workspace @codexer/mobile",
    "build:admin": "npm run build --workspace @codexer/admin",
    "dev:admin": "npm run dev --workspace @codexer/admin",
    "build:desktop": "node scripts/build-desktop.mjs",
    "dev:desktop": "npm run build:desktop && npm run start --workspace @codexer/desktop",
    "package:desktop": "npm run build:desktop && npm run package --workspace @codexer/desktop",
    "package:desktop:win": "npm run build:desktop && npm run package:win --workspace @codexer/desktop",
    "package:desktop:mac": "npm run build:desktop && npm run package:mac --workspace @codexer/desktop",
    "package:desktop:mac:local": "npm run build:desktop && npm run package:mac:local --workspace @codexer/desktop --",
    "build:control-desktop": "node scripts/build-control-desktop.mjs",
    "dev:control-desktop": "npm run build:control-desktop && npm run start --workspace @codexer/control-desktop",
    "package:control-desktop:win": "npm run build:control-desktop && npm run package:win --workspace @codexer/control-desktop",
    "typecheck:control-desktop": "npm run typecheck --workspace @codexer/control-desktop",
    "package:server": "node scripts/package-server.mjs",
    "export:source": "node scripts/export-source.mjs",
    "check:docs": "node scripts/check-docs.mjs",
    "check:preview-runtime": "node scripts/build-preview-runtime.mjs --check",
    "mobile:start": "npm run start --workspace @codexer/mobile",
    "mobile:typecheck": "npm run typecheck --workspace @codexer/mobile",
    "mobile:export": "npm run check:preview-runtime && npm run export --workspace @codexer/mobile",
    "icons:mobile": "node scripts/generate-mobile-icons.mjs",
    "dev:web": "node scripts/dev-web.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit && npm run typecheck --workspace @codexer/admin && npm run typecheck --workspace @codexer/desktop && npm run typecheck:control-desktop",
    "test": "vitest run",
    "dev:relay": "tsx apps/relay/src/main.ts",
    "format:relay": "prettier --write \"apps/relay/src/**/*.ts\"",
    "check:format:relay": "prettier --check \"apps/relay/src/**/*.ts\"",
    "start:relay": "node dist/apps/relay/src/main.js",
    "dev:agent": "tsx apps/pc-agent/src/main.ts",
    "users": "tsx scripts/manage-users.ts",
    "local:start": "tsx scripts/local-services.ts start",
    "local:stop": "tsx scripts/local-services.ts stop",
    "local:status": "tsx scripts/local-services.ts status",
    "check:live": "tsx scripts/check-live.ts",
    "check:control": "tsx scripts/accept-control.ts",
    "check:model-usage": "tsx scripts/accept-model-usage.ts",
    "check:effort-images": "tsx scripts/accept-effort-images.ts",
    "check:stop": "tsx scripts/accept-stop.ts",
    "check:approval": "tsx scripts/accept-approval.ts",
    "check:input": "tsx scripts/accept-input.ts"
  },
  "dependencies": {
    "@electric-sql/pglite": "^0.3.16",
    "@fastify/rate-limit": "^10.3.0",
    "@fastify/static": "^10.1.5",
    "@fastify/websocket": "^11.3.1",
    "fastify": "^5.12.5",
    "highlight.js": "^11.12.0",
    "immer": "^11.1.18",
    "markdown-it": "^15.0.2",
    "markdown-it-task-lists": "^2.1.1",
    "pg": "^8.23.0",
    "qrcode": "^1.5.4",
    "ws": "^8.22.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/jsdom": "^30.0.0",
    "@types/markdown-it": "^14.2.0",
    "@types/node": "^24.19.0",
    "@types/pg": "^8.23.1",
    "@types/pngjs": "^6.0.5",
    "@types/qrcode": "^1.5.6",
    "@types/ws": "^8.18.1",
    "electron": "44.5.1",
    "electron-builder": "26.15.3",
    "esbuild": "0.28.2",
    "jsdom": "^30.1.2",
    "pngjs": "^7.0.0",
    "prettier": "3.9.9",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite": "8.3.1",
    "vitest": "^4.1.11"
  }
}
